# Application
APP_ENV=development

# PostgreSQL
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent_dev
POSTGRES_DB=enterprise_agent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Model Gateway
# Used from M1 onward.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# Embedding
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MAX_TOKENS=700
EMBEDDING_OVERLAP_TOKENS=100
EMBEDDING_BATCH_SIZE=1
EMBEDDING_MAX_SEQUENCE_LENGTH=1024